# ==========================================
# 1. Django Core Configuration
# ==========================================
SECRET_KEY=your_secret_key_here
DEBUG=True
ALLOWED_HOSTS=*,localhost,127.0.0.1

# ==========================================
# 2. Database Configuration (PostgreSQL for Docker/VPS)
# ==========================================
POSTGRES_DB=realestatedb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ==========================================
# 3. Email Configuration (SMTP / SendGrid / Mailgun)
# ==========================================
DEFAULT_FROM_EMAIL=no-reply@realestate.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password

# ==========================================
# 4. Cloudflare R2 Media Storage Configuration (S3 Compatible)
# ==========================================
USE_R2=False
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_CUSTOM_DOMAIN=media.yourdomain.com

# ==========================================
# 5. Pusher Channels Live Chat Configuration
# ==========================================
PUSHER_APP_ID=1234567
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=mt1
